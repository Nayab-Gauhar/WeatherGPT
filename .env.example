# ---------------------------------------------------------------------------
# WeatherGPT — optional configuration
#
# The app runs with NO configuration at all. Every weather, air-quality and
# climate endpoint it uses is keyless, and query understanding runs locally.
# Everything below is opt-in.
# ---------------------------------------------------------------------------

# Optional hosted LLM for open-ended questions (see src/services/llm.js).
# When unset, the deterministic parser in src/services/nlu.js handles every
# query — which is the default and recommended configuration for a demo.
#
# A browser-side key is acceptable for local experimentation only; in a real
# deployment this call belongs behind the API gateway so the credential never
# reaches the client.
#
# VITE_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
# VITE_LLM_MODEL=gpt-4o-mini
# VITE_LLM_API_KEY=
